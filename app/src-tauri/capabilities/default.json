{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de la ventana principal",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://aistudio.google.com/*"
        },
        {
          "url": "https://console.groq.com/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ],
  "platforms": [
    "linux",
    "windows",
    "macOS"
  ]
}
