{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Librería SIGLO XXI",
  "version": "1.2.0",
  "identifier": "pe.sigloxxi.libreria",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "Librería SIGLO XXI",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost lan: http://lan.localhost data: blob: https://covers.openlibrary.org https://archive.org https://*.archive.org https://books.google.com https://books.googleusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Inventario, búsqueda y ventas de la Librería SIGLO XXI",
    "category": "Business",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3OTY1M0RCQzY1RkFFRjYKUldUMnJsL0cyMU9XTjVxU3l4MWxXd29INDNsNEdVRmpaVk05ME1Ld1N5MDRmNlZIcjJVWkxWYUMK",
      "endpoints": [
        "https://pub-f41a4d67dc1a41729f716c52c8052735.r2.dev/a80fe818213ab3041cf119499c547661/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
